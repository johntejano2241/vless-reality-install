{
  "name": "esmi/vpn-admin",
  "description": "Admin-only management for the VLESS REALITY installer",
  "type": "project",
  "license": "proprietary",
  "require": {"php": "^8.4", "laravel/framework": "^13.0", "filament/filament": "^5.0"},
  "require-dev": {"phpunit/phpunit": "^12.0", "mockery/mockery": "^1.6", "fakerphp/faker": "^1.24"},
  "autoload": {"psr-4": {"App\\": "app/"}},
  "autoload-dev": {"psr-4": {"Tests\\": "tests/"}},
  "scripts": {
    "post-autoload-dump": ["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump", "@php artisan package:discover --ansi"],
    "test": "@php vendor/bin/phpunit"
  },
  "config": {"optimize-autoloader": true, "preferred-install": "dist", "sort-packages": true},
  "minimum-stability": "stable",
  "prefer-stable": true
}

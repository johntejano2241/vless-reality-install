[Unit]
Description=Manage per-client VLESS public-IP connection slots
After=reality-vless.service
Requires=reality-vless.service
PartOf=reality-vless.service

[Service]
Type=simple
User=root
Group=reality-vless
ExecStart=/usr/bin/python3 /usr/local/lib/reality-vless/ip_limiter.py
Restart=on-failure
RestartSec=2
RuntimeDirectory=reality-vless-limits
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=restart
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/reality-vless-limits /run/lock

[Install]
WantedBy=multi-user.target
